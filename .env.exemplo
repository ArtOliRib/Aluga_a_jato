# ============================================================================
# .env.exemplo - Copie para .env e preencha com seus valores.
#   cp .env.exemplo .env
# O arquivo .env e ignorado pelo git (.gitignore) e NUNCA deve ser versionado.
# ============================================================================

# --- Chaves de protecao de dados pessoais (LGPD) - OBRIGATORIAS ---------------
# A aplicacao NAO sobe sem elas: nao ha valor padrao de proposito.
# Gere cada uma com:  openssl rand -base64 32   (32 bytes = 256 bits)
#
# ATENCAO: perder a chave de CIFRA torna os dados pessoais definitivamente
# ilegiveis. Em producao, guarde em um secret manager (Vault, AWS Secrets
# Manager, Azure Key Vault) e nunca no git.
#
# indice-chave: HMAC-SHA-256 (gera os indices de busca/igualdade)
# cifra-chave:  AES-256-GCM (cifra os dados pessoais)
LOCADORA_DADO_PESSOAL_INDICE_CHAVE=
LOCADORA_DADO_PESSOAL_CIFRA_CHAVE=

# --- Banco de dados (opcional) ------------------------------------------------
# Padrao aponta para localhost:5432 (execucao local). Sobrescreva conforme
# necessario. No docker-compose, SPRING_DATASOURCE_URL aponta para o servico
# aluguel-db.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/meubanco
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=secretpassword

# --- JPA / Hibernate (opcional) -----------------------------------------------
# create | create-drop | update | validate | none
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# --- Servidor (opcional) ------------------------------------------------------
SERVER_PORT=8080
